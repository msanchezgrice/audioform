# Copy the web settings into apps/web/.env.local for local development.
# Use the existing Vercel integrations in production. Never commit credentials.
DATABASE_URL=
TALKFORM_DATA_ENCRYPTION_KEY=
CRON_SECRET=
TALKFORM_LIMITER_PEPPER=
TALKFORM_RATE_LIMIT_PEPPER=
TALKFORM_APP_URL=http://localhost:3000

# Existing Clerk application. The operator allowlist accepts verified emails.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
TALKFORM_OPERATOR_EMAILS=
TALKFORM_OPERATOR_EMAIL=
TALKFORM_OPERATOR_USER_IDS=
TALKFORM_INTERNAL_USER_IDS=

# Text works without OpenAI. Voice and AI importer refinement share DB budgets.
OPENAI_API_KEY=
TALKFORM_ENABLE_PUBLIC_REALTIME=false
TALKFORM_AI_KILL_SWITCH=false

# Optional existing marketing analytics; private respondent routes are excluded.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_TALKFORM_GA_MEASUREMENT_ID=

# Explicitly opt in to the legacy process-local API only for local experiments.
TALKFORM_ENABLE_IN_MEMORY_SESSIONS=false
