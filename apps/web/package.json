{
  "name": "@talkform/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node --import tsx scripts/prepare-production.ts && pnpm --filter @talkform/core build && pnpm --filter @talkform/react build && pnpm --filter @talkform/mcp build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "pretypecheck": "pnpm --filter @talkform/core build && pnpm --filter @talkform/react build && pnpm --filter @talkform/mcp build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.6",
    "@talkform/core": "workspace:*",
    "@talkform/http": "workspace:*",
    "@talkform/mcp": "workspace:*",
    "@talkform/react": "workspace:*",
    "cheerio": "^1.2.0",
    "ipaddr.js": "^2.4.0",
    "json5": "^2.2.3",
    "next": "16.3.3",
    "postgres": "^3.4.9",
    "posthog-js": "^1.399.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^22.3.2",
    "undici": "^8.9.0",
    "workflow": "^4.8.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
