{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "crons": [
    {
      "path": "/api/internal/maintenance",
      "schedule": "17 4 * * *"
    },
    {
      "path": "/api/realtime/cleanup",
      "schedule": "23 4 * * *"
    }
  ]
}
