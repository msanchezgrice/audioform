{
  "version": 2,
  "builds": [
    {
      "src": "apps/web/package.json",
      "use": "@vercel/next"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/apps/web/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/maintenance",
      "schedule": "17 4 * * *"
    },
    {
      "path": "/api/realtime/cleanup",
      "schedule": "23 4 * * *"
    }
  ]
}
